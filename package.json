{
  "name": "lumina",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Lumina — a from-scratch, browser-native JavaScript animation engine for Manim/3Blue1Brown-style explainer videos, math/physics/CS/AI-ML visualizations, and interactive educational embeds.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.5",
    "katex": "^0.16.22",
    "mathjax-full": "^3.2.1",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/katex": "^0.16.7",
    "@types/opentype.js": "^1.3.8",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
